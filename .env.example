# --- Core ---
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://localhost:5432/agentgrid
# Vercel Redis / Upstash / local redis (TCP URL, rediss:// in prod)
REDIS_URL=redis://localhost:6379

# --- Secrets (generate: openssl rand -base64 32) ---
# Key-encryption key that wraps each tenant's data key (envelope encryption).
MASTER_KEY=
# Signs session JWTs.
SESSION_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# Protects /api/metrics (Prometheus scrape, local only by default).
METRICS_TOKEN=

# --- LLM (model ops) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Set to "false" to run fully deterministic (no cloud LLM) – e.g. HIPAA tenants.
LLM_ENABLED=true

# --- Queue tuning ---
QUEUE_MAX_ATTEMPTS=5
QUEUE_DRAIN_BUDGET_MS=8000
